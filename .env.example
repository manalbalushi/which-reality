# Supabase project settings — https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Service role key — server-only, NEVER exposed to the browser or committed.
# Used by scripts/seed-auth-users.mjs and by server-only Storage operations.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# App display name (optional)
NEXT_PUBLIC_APP_NAME="OT Risk Management"
